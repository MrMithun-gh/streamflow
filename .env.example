# Copy this file to .env and fill in real values:  cp .env.example .env

# --- PostgreSQL ---
POSTGRES_USER=streamflow
POSTGRES_PASSWORD=change_me
POSTGRES_DB=streamflow

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=transactions

# --- Producer ---
PRODUCER_EVENTS_PER_SECOND=2

# --- PostgreSQL (as seen from your Windows machine) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5433